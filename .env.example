# Set these in your shell or GitHub repository Variables. Scout does not load .env files.
# Defaults preserve the original Groq picker + Claude Code solver.
SCOUT_PICKER_PROVIDER=groq
SCOUT_SOLVER_PROVIDER=claude-code
SCOUT_PICKER_MODEL=openai/gpt-oss-120b
SCOUT_SOLVER_MODEL=
SCOUT_PICKER_AUTH=auto
SCOUT_SOLVER_AUTH=auto
SCOUT_PICKER_BASE_URL=
SCOUT_SOLVER_BASE_URL=
# Optional: path to a complete personal profile (relative to this repository).
SCOUT_PROFILE=profile.json

# Set only the credentials needed by the providers you select. Keep values out of Git.
GROQ_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CODEX_API_KEY=
# Generic OpenAI-compatible key, or independent per-stage keys:
SCOUT_API_KEY=
SCOUT_PICKER_API_KEY=
SCOUT_SOLVER_API_KEY=
GH_TOKEN=
LANGSMITH_API_KEY=

# Email uses profile.json's "email" and "email_enabled" (set by the Issue Scout app). An address alone
# never sends. This override only changes the To: line of local previews; the workflow doesn't pass it.
SCOUT_RECIPIENT_EMAIL=
# The operator's relay base URL (no /send), written to the repository by the app when email is on.
# No Resend key on runners.
SCOUT_EMAIL_RELAY_URL=
