# Operator-side settings ONLY. Never copy the Resend key into generated user repositories.
# Copy into your hosting service's environment/secret settings, not profile.json.
RESEND_API_KEY=
SCOUT_EMAIL_FROM=noreply@scouts.email
# Full public HTTPS endpoint, including /send. Also used as the GitHub OIDC audience.
SCOUT_EMAIL_RELAY_URL=
# Map immutable GitHub repository IDs to the owner ID and confirmed destination email.
# Example enrollment only; replace with real records before enabling delivery.
SCOUT_EMAIL_RECIPIENTS={"12345678":{"owner_id":"9876","email":"user@example.com","ref":"refs/heads/main"}}
