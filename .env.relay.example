# Operator-side settings for email_relay.py ONLY. Never copy the Resend key into generated user
# repositories, the desktop app, profiles or workflow secrets. Put RESEND_API_KEY and
# SCOUT_EMAIL_RELAY_SECRET in your host's secret store; the rest can be plain environment settings.
RESEND_API_KEY=
# The noreply address on your Resend-verified sending domain. No inbox is needed behind it.
SCOUT_EMAIL_FROM=
# This relay's public HTTPS base URL, without /send. Also the GitHub OIDC audience, the value the
# app writes to each repository's SCOUT_EMAIL_RELAY_URL, and the app's EMAIL_RELAY_URL.
SCOUT_EMAIL_RELAY_URL=
# 32 or more random characters; confirmation codes are derived from it. Changing it voids pending codes.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SCOUT_EMAIL_RELAY_SECRET=
# SQLite file on a persistent disk: confirmed recipients, pending codes, quotas and sent-email records.
SCOUT_EMAIL_DB=/data/relay.sqlite3
# Optional limits (defaults shown). The shared ones match Resend's free plan; raise them with your plan.
# Reports stop at (100 - CODE_RESERVE_PERCENT)% of the shared limits, keeping headroom for confirmation codes.
SCOUT_EMAIL_DAILY_LIMIT=100
SCOUT_EMAIL_MONTHLY_LIMIT=3000
SCOUT_EMAIL_USER_DAILY_LIMIT=3
SCOUT_EMAIL_USER_MONTHLY_LIMIT=40
SCOUT_EMAIL_USER_DAILY_CODES=3
SCOUT_EMAIL_USER_MONTHLY_CODES=10
SCOUT_EMAIL_CODE_RESERVE_PERCENT=10
# Optional operator enrollments that skip the code, keyed by immutable repository ID, e.g.
# {"12345678":{"owner_id":"9876","email":"user@example.com","ref":"refs/heads/main"}}
SCOUT_EMAIL_RECIPIENTS={}
